{
  "name": "3drossa",
  "version": "0.3.0",
  "description": "An engine for scroll-driven 3D experiences: stations, travel, and a visual path editor that runs inside your own page.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/core/index.js",
    "./react": "./dist/react/index.js",
    "./editor": "./dist/editor/index.js",
    "./next": "./dist/next/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "npm run build",
    "verify": "node tools/verify-package.mjs"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19 <19.3",
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.175.0"
  },
  "keywords": [
    "scroll",
    "three",
    "react-three-fiber",
    "webgl",
    "scrollytelling",
    "camera",
    "spline"
  ],
  "workspaces": [
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahbilal-y/3drossa.git"
  },
  "homepage": "https://github.com/abdullahbilal-y/3drossa#readme",
  "bugs": {
    "url": "https://github.com/abdullahbilal-y/3drossa/issues"
  },
  "sideEffects": false,
  "dependencies": {}
}
